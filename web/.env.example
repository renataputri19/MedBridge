# Base URL of the MedBridge backend REST surface.
# The frontend NEVER calls an LLM provider directly — the backend owns Hermes.
VITE_API_BASE_URL=/api/v1

# Realtime transport for operational events: "sse" | "ws" | "mock"
VITE_REALTIME_TRANSPORT=mock

# Force the offline/fallback mock layer even when a backend is reachable.
VITE_USE_MOCKS=true

# Milliseconds before an API call is considered unreachable and falls back to mocks.
VITE_API_TIMEOUT_MS=4000

# Public WhatsApp number used by patient-facing itinerary CTAs (digits only).
VITE_WHATSAPP_NUMBER=6580000000
